{
  "name": "autohelper-desktop",
  "version": "0.1.0",
  "description": "AutoHelper desktop shell — Electron tray + dashboard window",
  "private": true,
  "author": "OkVery",
  "main": ".vite/build/index.js",
  "scripts": {
    "start": "electron-forge start",
    "dev": "node -e \"const fs=require('fs'),p=require('path'),ud=p.join(process.env.APPDATA||'','autohelper-desktop');['.vite','out'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}));['Cache','Code Cache','GPUCache','DawnGraphiteCache','DawnWebGPUCache'].forEach(d=>{const t=p.join(ud,d);fs.rmSync(t,{recursive:true,force:true})})\" && electron-forge start",
    "dev:autohelper": "node -e \"const fs=require('fs'),p=require('path'),ud=p.join(process.env.APPDATA||'','autohelper-desktop');['.vite','out'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}));['Cache','Code Cache','GPUCache','DawnGraphiteCache','DawnWebGPUCache'].forEach(d=>{const t=p.join(ud,d);fs.rmSync(t,{recursive:true,force:true})})\" && electron-forge start",
    "dev:autoart": "node -e \"const fs=require('fs'),p=require('path'),ud=p.join(process.env.APPDATA||'','autohelper-desktop');['.vite','out'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}));['Cache','Code Cache','GPUCache','DawnGraphiteCache','DawnWebGPUCache'].forEach(d=>{const t=p.join(ud,d);fs.rmSync(t,{recursive:true,force:true})})\" && electron-forge start -- --mode=autoart",
    "build": "electron-forge make",
    "package": "electron-forge package",
    "typecheck": "tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "electron-log": "^5.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "electron": "^35.7.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
